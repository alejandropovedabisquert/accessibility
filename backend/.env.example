# Puerto de la API
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma). "*" para permitir todos.
CORS_ORIGIN=http://localhost:3001

# Rutas de datos (relativas a backend/ o absolutas)
DATA_DIR=./data
RESULTS_DIR=./scan-results

# Escaneos simultaneos. Cada uno abre un contexto de navegador.
SCAN_CONCURRENCY=3
# Milisegundos que un navegador sigue vivo sin trabajo antes de cerrarse
BROWSER_IDLE_TIMEOUT_MS=60000

# Limites por auditoria
MAX_URLS_PER_AUDIT=25
DEFAULT_TIMEOUT_MS=30000
